# Docker Alpine stack local environment.
# Copy to deploy/docker/.env and edit. This file is gitignored.

# Browser origins allowed by the API. Use the CMS/tablet URL, comma-separated.
# Replace <ip-server> with the server LAN address before starting.
ALPINE_CORS_ORIGINS=http://localhost:8082

# Required secrets. Generate with:
#   openssl rand -hex 24   # database password
#   openssl rand -hex 48   # JWT secret
ALPINE_PGPASSWORD=<database-password>
ALPINE_JWT_SECRET=<at-least-32-character-random-secret>

# One hop is the local nginx. Use 2 when an external nginx proxies to it.
ALPINE_TRUST_PROXY=1
# Keep true for production. UAT may explicitly set false while floors are incomplete.
ALPINE_FLOOR_RESTRICTION=true

# Optional: store PostgreSQL inside the repo instead of the named volume.
# Linux/ext4 only; database/pgdata/ is gitignored.
# ALPINE_DB_PATH=../../database/pgdata
