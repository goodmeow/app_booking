# Template environment produksi — salin ke /etc/360booking/app.env dan
# ganti seluruh `change-me`. File env memakai sintaks systemd, bukan shell:
# tanpa tanda kutip ganda bersarang, tanpa perintah.

NODE_ENV=production
BASE=/

# API terikat loopback karena nginx di depannya. HTTPS=true hanya bila
# node sendiri yang melayani TLS (tanpa nginx).
HOST=127.0.0.1
PORT=8081
SERVER_PORT=9091
HTTPS=false
SSR=false
TRUST_PROXY=true

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=360booking
PGUSER=360booking
PGPASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRY_TOKEN=1d
JWT_ISSUER=360-scheduler
JWT_AUDIENCE=360-scheduler-web
KIOSK_JWT_AUDIENCE=360-scheduler-kiosk
KIOSK_JWT_EXPIRY=15m
KIOSK_REFRESH_DAYS=30

# Origin browser tanpa wildcard; samakan dengan https://<host> yang dipakai CMS.
CORS_ORIGINS=https://scheduler.contoh.id

# Variabel ini hanya dipakai 02-provision-database.sh / 05-create-admin.sh;
# server menjalankan role terbatas (PGUSER) dan tidak memakai PG_SUPERUSER.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me

# Akun admin pertama untuk 05-create-admin.sh.
ADMIN_EMAIL=admin@contoh.id
ADMIN_NAME=Admin Kios
ADMIN_PASSWORD=change-me

TLS_CERT_PATH=
TLS_KEY_PATH=

# Kebijakan kios/booking yang sudah jadi produk saat ini.
APP_TIMEZONE=Asia/Jakarta
MAX_BOOKING_DURATION_HOURS=24
MAX_CALENDAR_RANGE_DAYS=120
MAX_PREVIEW_CONFLICTS=50
# Batas rekurensi (opsional; default 366 hari / 200 kejadian per seri).
RECURRENCE_MAX_DAYS=366
RECURRENCE_MAX_OCCURRENCES=200
