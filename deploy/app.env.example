# Production environment template: copy to /etc/360booking/app.env and
# replace every `change-me`. The env file uses systemd syntax, not shell:
# no nested double quotes, no commands.

NODE_ENV=production
BASE=/

# The API binds to loopback because nginx sits in front of it. HTTPS=true only when
# node itself serves TLS (without nginx).
HOST=127.0.0.1
PORT=8081
SERVER_PORT=9091
HTTPS=false
SSR=false
TRUST_PROXY=1

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=360booking
PGUSER=360booking
PGPASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRY_TOKEN=1d
JWT_ISSUER=360-scheduler
JWT_AUDIENCE=360-scheduler-web
KIOSK_JWT_AUDIENCE=360-scheduler-kiosk
KIOSK_JWT_EXPIRY=15m
KIOSK_REFRESH_DAYS=30

# Browser origins without wildcards; match the https://<host> the CMS uses.
CORS_ORIGINS=https://scheduler.contoh.id

# Superuser and optional admin bootstrap values live in provision.env, not
# here: systemd loads this file into the app process. See provision.env.example.

TLS_CERT_PATH=
TLS_KEY_PATH=

# Kiosk/booking policies that are already part of the product.
APP_TIMEZONE=Asia/Jakarta
MAX_BOOKING_DURATION_HOURS=168
MAX_CALENDAR_RANGE_DAYS=120
MAX_PREVIEW_CONFLICTS=50
# Recurrence limits (optional; default 366 days / 200 occurrences per series).
RECURRENCE_MAX_DAYS=366
RECURRENCE_MAX_OCCURRENCES=200
