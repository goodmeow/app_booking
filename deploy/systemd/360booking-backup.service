[Unit]
Description=360 Scheduler PostgreSQL backup
After=postgresql.service network-online.target
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
# Install the script first:
#   sudo install -m 0755 database/scripts/backup-db.sh /usr/local/sbin/360booking-backup
# Credentials live in a root-owned env file (chmod 0600).
EnvironmentFile=/etc/360booking/backup.env
ExecStart=/usr/local/sbin/360booking-backup
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/360booking
NoNewPrivileges=true
TimeoutStartSec=30min
