# Provisioning-only secrets. Root-only, not loaded by systemd.
# Copy to /etc/360booking/provision.env and replace every value.

PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me

# Optional: used only by deploy/05-create-admin.sh.
ADMIN_EMAIL=admin@contoh.id
ADMIN_NAME=Admin Kios
ADMIN_PASSWORD=change-me
