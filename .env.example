# Production template: copy to .env.production and replace every placeholder.
NODE_ENV=production
PORT=8081
SERVER_PORT=9091
BASE=/
# Bind locally behind a trusted reverse proxy or set the deployment interface.
HOST=0.0.0.0
HTTPS=false
SSR=false

PGHOST=localhost
PGUSER=postgres
PGDATABASE=360booking
PGPASSWORD=change-me
PGPORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY=
REDIS_DB=0

# server.bundle.js reads JWT_SECRET. JWT_SECRET_KEY from legacy .env is not read.
JWT_SECRET=change-me
JWT_EXPIRY_TOKEN=1d
JWT_ISSUER=360-scheduler
JWT_AUDIENCE=360-scheduler-web
KIOSK_JWT_AUDIENCE=360-scheduler-kiosk
KIOSK_JWT_EXPIRY=15m
KIOSK_REFRESH_DAYS=30

# Comma-separated browser origins. Wildcards are rejected by the server.
CORS_ORIGINS=https://scheduler.example.com
# Set to loopback when a trusted reverse proxy runs on the same host.
TRUST_PROXY=

# Required only when HTTPS=true.
TLS_CERT_PATH=
TLS_KEY_PATH=

APP_TIMEZONE=Asia/Jakarta
MAX_BOOKING_DURATION_HOURS=168
# Rentang tanggal terpanjang untuk satu permintaan kalender/jadwal kiosk.
MAX_CALENDAR_RANGE_DAYS=366
# Jumlah maksimum konflik yang dikembalikan endpoint preview.
MAX_PREVIEW_CONFLICTS=50
RECURRENCE_MAX_DAYS=366
RECURRENCE_MAX_OCCURRENCES=200
