NODE_ENV=development
PORT=3000
SERVER_PORT=5000
BASE=/
HOST=localhost
HTTPS=false
SSR=false

PGHOST=localhost
PGUSER=postgres
PGDATABASE=360booking
PGPASSWORD=change-me
PGPORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY=
REDIS_DB=0

# server.bundle.js reads JWT_SECRET. JWT_SECRET_KEY from legacy .env is not read.
JWT_SECRET=change-me
JWT_EXPIRY_TOKEN=1d
JWT_ISSUER=360-scheduler
JWT_AUDIENCE=360-scheduler-web

# Comma-separated browser origins. Wildcards are rejected by the server.
CORS_ORIGINS=http://localhost:3000
# Set to loopback when a trusted reverse proxy runs on the same host.
TRUST_PROXY=

# Required only when HTTPS=true.
TLS_CERT_PATH=
TLS_KEY_PATH=

APP_TIMEZONE=Asia/Jakarta
MAX_BOOKING_DURATION_HOURS=168
RECURRENCE_MAX_DAYS=366
RECURRENCE_MAX_OCCURRENCES=200
