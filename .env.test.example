NODE_ENV=test

# Dedicated disposable database only. Never point tests at production.
# Parity/regression suites reset 360booking_parity_test; the demo database
# 360booking_reconstruction_test (accounts, cards, tablet pairing) is off limits.
PGHOST=localhost
PGPORT=54320
PGUSER=booking_test
PGPASSWORD=booking_test_local_only
PGDATABASE=360booking_parity_test

# Compose-only names, separate from legacy runtime variables.
BOOKING_TEST_PORT=54320
BOOKING_TEST_DB=360booking_parity_test
BOOKING_TEST_USER=booking_test
BOOKING_TEST_PASSWORD=booking_test_local_only

# Database dropped and rebuilt by database/scripts/reset-parity-db.sh and by
# the parity/regression harness (override only for throwaway databases).
BOOKING_PARITY_DB=360booking_parity_test

# Used later by server contract tests.
JWT_SECRET=test-only-secret-replace-me-32-characters-minimum
JWT_ISSUER=360-scheduler
JWT_AUDIENCE=360-scheduler-web
KIOSK_JWT_AUDIENCE=360-scheduler-kiosk
KIOSK_JWT_EXPIRY=15m
KIOSK_REFRESH_DAYS=30
CORS_ORIGINS=http://127.0.0.1:3000
APP_TIMEZONE=Asia/Jakarta
