{
  "name": "360booking-cms",
  "private": true,
  "version": "3.6.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "demo": "node scripts/demo.js",
    "demo:accounts": "node scripts/demo-accounts.js",
    "demo:stop": "docker --context default compose --project-name 360booking --file compose.yaml --env-file .env.demo stop postgres-test",
    "development": "node scripts/dev-combined.js",
    "dev:client": "node scripts/dev-client.js",
    "dev:server": "node scripts/dev-server.js",
    "build": "npm run build:client && npm run build:server && npm run create:server:package",
    "build:client": "vite build --outDir build/client --mode production",
    "build:server": "webpack --mode production --config webpack.config.cjs",
    "build:server:check": "cross-env SERVER_OUT_DIR=/tmp/360booking-server-build webpack --mode production --config webpack.config.cjs",
    "create:server:package": "node scripts/create-server-package.js",
    "start:client": "node scripts/start-client.js",
    "start:server": "node scripts/start-server.js",
    "test:client": "node --test client/tests/*.test.js",
    "test:server:unit": "node --test server/tests/unit/*.test.js",
    "test:server:parity:prepare": "node --test --test-concurrency=1 server/tests/parity/prepare.test.js",
    "test:server:parity": "node --test --test-concurrency=1 server/tests/parity/*.test.js",
    "test:server:regression": "node --test --test-concurrency=1 server/tests/regression/*.test.js",
    "verify": "npm run build:client && npm run build:server:check && npm run test:client && npm run test:server:unit"
  },
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@fullcalendar/bootstrap5": "^6.1.5",
    "@fullcalendar/core": "^6.1.4",
    "@fullcalendar/daygrid": "^6.1.4",
    "@fullcalendar/interaction": "^6.1.5",
    "@fullcalendar/react": "^6.1.5",
    "@fullcalendar/resource-timeline": "^6.1.4",
    "@fullcalendar/timegrid": "^6.1.4",
    "@hot-loader/react-dom": "^17.0.2",
    "@mui/icons-material": "^5.11.11",
    "@mui/material": "^5.11.15",
    "@mui/styles": "^5.11.13",
    "@mui/x-data-grid": "^6.8.0",
    "@mui/x-date-pickers": "^6.0.3",
    "@reduxjs/toolkit": "^1.9.5",
    "@socket.io/redis-adapter": "^8.2.0",
    "axios": "^1.3.5",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "bootstrap": "^5.2.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.7",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "helmet": "^7.0.0",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^7.1.1",
    "pg": "^8.10.0",
    "react": "^17.0.2",
    "react-bootstrap": "^2.7.2",
    "react-bootstrap-daterangepicker": "^8.0.0",
    "react-calendar": "^4.1.0",
    "react-dom": "^17.0.2",
    "react-hot-loader": "^4.13.1",
    "react-i18next": "^17.0.10",
    "react-redux": "^8.0.5",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-select": "^5.7.2",
    "reactstrap": "^8.10.1",
    "redis": "^4.6.6",
    "sirv": "^2.0.2",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1",
    "url-loader": "^4.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-loader": "^10.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "terser": "^5.44.0",
    "terser-webpack-plugin": "^5.3.14",
    "vite": "^8.1.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
